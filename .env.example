# ================================================
# 服务配置
# ================================================
PORT=3088
# 绑定地址。默认 0.0.0.0（局域网可访问）；改 127.0.0.1 只允许本机访问
# HOST=0.0.0.0
# LOG_LEVEL=INFO

# 单请求体体积上限（字节）。超过则在解析前直接返回 413，避免超大请求挤占内存。
# 默认 16MB（16777216）；设为 0 表示不限制
# MAX_PAYLOAD_BYTES=16777216

# ================================================
# Gateway 鉴权配置（可选，默认自动生成）
# ================================================
# 管理员用户名（默认 admin）
# ADMIN_USERNAME=admin
# 管理员密码：留空/注释 = 禁用管理后台登录（首页与管理面板直接开放）
# 想启用登录，取消注释并填密码即可
# ADMIN_PASSWORD=

# 会话有效期（毫秒，默认 86400000 = 24小时）
# SESSION_MAX_AGE=86400000

# 会话签名密钥：留空则自动生成并写入 .gateway/session_secret
# 多机/多目录部署多个实例时必须显式设为同一值，否则各实例 session 互不认账
# SESSION_SECRET=

# 速率限制
# RATE_LIMIT_MAX_ATTEMPTS=5
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_BLOCK_MS=300000

# ================================================
# 集群配置（仅手工部署多实例时需要）
# ================================================
# 各 worker 端口（逗号分隔）。集群模式下由 ecosystem.cluster.config.cjs 自动注入
# CLUSTER_PORTS=3081,3082,3083,3084

# ================================================
# 网络 / 调试
# ================================================
# 设为 0 时跳过下游 TLS 证书校验。仅调试用，生产环境请勿设置
# NODE_TLS_REJECT_UNAUTHORIZED=0

# ================================================
# CodeBuddy 配置
# ================================================
# 凭证存储目录
# CODEBUDDY_CREDS_DIR=.codebuddy

# 未携带用户信息时使用的默认 X-User-Id
# CODEBUDDY_DEFAULT_USER_ID=unknown

# 企业站上游域名列表（逗号分隔），会出现在管理面板的「上游服务」下拉里
# 可填完整 URL 或仅域名；个人版域名（copilot.tencent.com / www.codebuddy.ai）会自动忽略
# 示例：
# CODEBUDDY_ENTERPRISE_HOSTS=https://abc.copilot.qq.com,https://xyz.copilot.qq.com

# 首字节超时（毫秒）：从发出请求到收到响应头的最长等待，默认 45 秒
# 只管"连上了但不回话"这一段；200 响应头一到就解除，不影响慢速长回答和 thinking
# 调小可以更快发现上游卡死并换号，调大则给特别慢的上游更多耐心
# CODEBUDDY_CONNECT_TIMEOUT_MS=45000

# 同一个请求内最多尝试几个账号（含首次），默认 2 = 首次失败后换一次号
# 作用域内只有一个可用账号时不会重试（换了还是同一个号）
# CODEBUDDY_FAILOVER_ATTEMPTS=2

# 流空闲超时（毫秒）：两次数据块间隔超过此值即判流卡死（默认 5 分钟）。0 = 关闭
# 避免慢速长回答（如推理模型长时间吐 thinking token）被误杀
# CODEBUDDY_IDLE_TIMEOUT_MS=300000

# 熔断/软冷却的"连续"判定窗口（毫秒）：窗口外的散点失败不累计，避免误熔断可用账号
# CODEBUDDY_BREAKER_WINDOW_MS=600000
# CODEBUDDY_SOFT_WINDOW_MS=1800000

# ================================================
# Relay 配置
# ================================================
# 凭证存储目录
# RELAY_CREDS_DIR=.relay
